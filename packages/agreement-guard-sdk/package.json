{
  "name": "@lazaruseth/agreement-guard",
  "version": "0.1.1",
  "description": "Agreement Guard SDK - Protect your AI agent's autonomy by capturing and validating agreements",
  "author": "RECEIPTS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/receipts-ai/agreement-guard"
  },
  "homepage": "https://receipts.fi",
  "bugs": {
    "url": "https://github.com/receipts-ai/agreement-guard/issues"
  },
  "keywords": [
    "agreement",
    "agent",
    "ai",
    "terms",
    "legal",
    "receipts",
    "claude",
    "openai",
    "langchain",
    "trust",
    "tos"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./adapters": {
      "import": {
        "types": "./dist/adapters/index.d.mts",
        "default": "./dist/adapters/index.mjs"
      },
      "require": {
        "types": "./dist/adapters/index.d.ts",
        "default": "./dist/adapters/index.js"
      }
    },
    "./adapters/claude": {
      "import": {
        "types": "./dist/adapters/claude.d.mts",
        "default": "./dist/adapters/claude.mjs"
      },
      "require": {
        "types": "./dist/adapters/claude.d.ts",
        "default": "./dist/adapters/claude.js"
      }
    },
    "./adapters/openai": {
      "import": {
        "types": "./dist/adapters/openai.d.mts",
        "default": "./dist/adapters/openai.mjs"
      },
      "require": {
        "types": "./dist/adapters/openai.d.ts",
        "default": "./dist/adapters/openai.js"
      }
    },
    "./adapters/langchain": {
      "import": {
        "types": "./dist/adapters/langchain.d.mts",
        "default": "./dist/adapters/langchain.mjs"
      },
      "require": {
        "types": "./dist/adapters/langchain.d.ts",
        "default": "./dist/adapters/langchain.js"
      }
    },
    "./adapters/openclaw": {
      "import": {
        "types": "./dist/adapters/openclaw.d.mts",
        "default": "./dist/adapters/openclaw.mjs"
      },
      "require": {
        "types": "./dist/adapters/openclaw.d.ts",
        "default": "./dist/adapters/openclaw.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "msw": "^2.2.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
